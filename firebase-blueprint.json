{
  "entities": {
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Profil instansi pemerintah daerah, dinas pendidikan, satuan pendidikan, kepala sekolah, logo kop surat, dan format penomoran naskah dinas.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pemerintahDaerah": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "dinasPendidikan": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "namaSekolah": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "npsn": {
          "type": "string",
          "maxLength": 20
        },
        "alamat": {
          "type": "string",
          "minLength": 2,
          "maxLength": 250
        },
        "kota": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "kodePos": {
          "type": "string",
          "maxLength": 15
        },
        "telepon": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "website": {
          "type": "string",
          "maxLength": 120
        },
        "kodeUnitSurat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "kepalaSekolahNama": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "kepalaSekolahNip": {
          "type": "string",
          "maxLength": 40
        },
        "kepalaSekolahPangkat": {
          "type": "string",
          "maxLength": 80
        },
        "logoDaerahDataUrl": {
          "type": "string",
          "maxLength": 260000
        },
        "logoSekolahDataUrl": {
          "type": "string",
          "maxLength": 260000
        },
        "tampilkanLogoKanan": {
          "type": "boolean"
        },
        "polaPenomoran": {
          "type": "string",
          "enum": ["kemendagri_2023", "kemendagri_bulan_romawi", "kemendagri_bulan_angka"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "pemerintahDaerah",
        "dinasPendidikan",
        "namaSekolah",
        "alamat",
        "kota",
        "kodeUnitSurat",
        "kepalaSekolahNama",
        "tampilkanLogoKanan",
        "polaPenomoran",
        "createdAt",
        "updatedAt"
      ]
    },
    "Employee": {
      "title": "Employee",
      "description": "Data master pegawai, guru, dan tenaga kependidikan di lingkungan sekolah.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "nip": {
          "type": "string",
          "maxLength": 40
        },
        "nuptk": {
          "type": "string",
          "maxLength": 40
        },
        "pangkatGolongan": {
          "type": "string",
          "maxLength": 80
        },
        "jabatan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "statusKepegawaian": {
          "type": "string",
          "enum": ["PNS", "PPPK", "Honorer", "CPNS"]
        },
        "unitKerja": {
          "type": "string",
          "maxLength": 120
        },
        "telepon": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "nama",
        "jabatan",
        "statusKepegawaian",
        "createdAt",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "Data master peserta didik / siswa termasuk identitas orang tua atau wali untuk surat keterangan, mutasi, undangan, dan panggilan.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "nis": {
          "type": "string",
          "maxLength": 30
        },
        "nisn": {
          "type": "string",
          "maxLength": 30
        },
        "tempatLahir": {
          "type": "string",
          "maxLength": 80
        },
        "tanggalLahir": {
          "type": "string",
          "maxLength": 30
        },
        "jenisKelamin": {
          "type": "string",
          "enum": ["L", "P"]
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "namaOrangTua": {
          "type": "string",
          "maxLength": 140
        },
        "pekerjaanOrangTua": {
          "type": "string",
          "maxLength": 100
        },
        "alamat": {
          "type": "string",
          "maxLength": 250
        },
        "teleponOrangTua": {
          "type": "string",
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Mutasi Keluar", "Lulus"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "nama",
        "kelas",
        "jenisKelamin",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Letter": {
      "title": "Letter",
      "description": "Arsip naskah dinas elektronik sekolah sesuai tata naskah dinas Kemendagri.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kategori": {
          "type": "string",
          "enum": [
            "surat_tugas_sppd",
            "surat_keterangan",
            "surat_mutasi",
            "surat_penerimaan_mutasi",
            "surat_undangan",
            "surat_panggilan"
          ]
        },
        "subKategori": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "kodeKlasifikasi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "nomorUrut": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "nomorSurat": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "tanggalSurat": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "perihal": {
          "type": "string",
          "minLength": 2,
          "maxLength": 220
        },
        "tujuanSurat": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["draf", "terbit", "arsip"]
        },
        "modeTtd": {
          "type": "string",
          "enum": ["tte", "basah"]
        },
        "payload": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "kategori",
        "subKategori",
        "kodeKlasifikasi",
        "nomorUrut",
        "nomorSurat",
        "tanggalSurat",
        "perihal",
        "status",
        "modeTtd",
        "payload",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/schoolSettings/{userId}": {
      "schema": { "$ref": "#/entities/SchoolSettings" },
      "description": "Pengaturan kop surat, logo, kepala sekolah, dan penomoran milik operator sekolah atau workspace bersama sekolah (smpnegeripacet_shared)."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Daftar pegawai/guru yang terisolasi berdasarkan ownerId atau workspace bersama sekolah."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Daftar siswa dan data orang tua yang terisolasi berdasarkan ownerId atau workspace bersama sekolah."
    },
    "/letters/{letterId}": {
      "schema": { "$ref": "#/entities/Letter" },
      "description": "Buku agenda dan arsip naskah dinas elektronik yang terisolasi berdasarkan ownerId atau workspace bersama sekolah."
    }
  }
}
